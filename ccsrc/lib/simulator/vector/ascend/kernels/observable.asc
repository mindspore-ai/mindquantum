#include <acl/acl.h>

#include "common.inc"
#define MQ_ASCEND_OBSERVABLE_DEVICE_ONLY
#include "simulator/vector/ascend/observable.h"

#ifdef __FAST_MATH__
#    error "observable.asc requires strict FP32: compile with -fno-fast-math -ffp-contract=off"
#endif

using namespace AscendC;                   // NOLINT
using namespace mindquantum::sim::ascend;  // NOLINT

namespace {
constexpr uint32_t T = kObservableTileSize;
using device::CompensatedSum;
using device::Deposit;
using device::Parity;
using device::Sync;

// Fixed 53,344-byte UB footprint, independent of state/observable/shot size.
// All vector operands begin on 32-byte boundaries. Amplitude arithmetic is
// vectorized; CSR gathers, metadata, padding and final sampling use scalar IO.
class TileMath {
 protected:
    __aicore__ inline void InitMath(uint64_t dimension) {
        dimension_ = dimension;
        plane_ = dimension < 8 ? 8 : dimension;
        size_ = plane_ < T ? static_cast<uint32_t>(plane_) : T;
        pipe_.InitBuffer(a_buf_, 2 * T * sizeof(float));
        pipe_.InitBuffer(b_buf_, 2 * T * sizeof(float));
        pipe_.InitBuffer(c_buf_, 2 * T * sizeof(float));
        pipe_.InitBuffer(work_buf_, 4 * T * sizeof(float));
        pipe_.InitBuffer(index_buf_, 2 * T * sizeof(uint32_t));
        pipe_.InitBuffer(mask_buf_, T * sizeof(float));
        pipe_.InitBuffer(scalar_buf_, 16 * sizeof(float));
        pipe_.InitBuffer(partial_buf_, 8 * sizeof(float));
    }

    __aicore__ inline void Load(GlobalTensor<float> source, LocalTensor<float> target, uint64_t base) {
        Sync<HardEvent::V_MTE2>();
        DataCopy(target, source[base], size_);
        DataCopy(target[T], source[plane_ + base], size_);
        Sync<HardEvent::MTE2_V>();
    }

    __aicore__ inline void ClearPadding(LocalTensor<float> data) {
        if (dimension_ < 8) {
            Sync<HardEvent::V_S>();
            for (uint32_t i = static_cast<uint32_t>(dimension_); i < 8; ++i) {
                data.SetValue(i, 0.0F);
            }
            Sync<HardEvent::S_V>();
        }
    }

    __aicore__ inline void StoreState(GlobalTensor<float> target, LocalTensor<float> source, uint64_t base) {
        ClearPadding(source);
        ClearPadding(source[T]);
        Sync<HardEvent::V_MTE3>();
        Sync<HardEvent::S_MTE3>();
        DataCopy(target[base], source, size_);
        DataCopy(target[plane_ + base], source[T], size_);
        Sync<HardEvent::MTE3_V>();
        Sync<HardEvent::MTE3_S>();
    }

    // w[0] = real and w[2*T] = imag, for conj(lhs)*rhs.
    __aicore__ inline void Dot(LocalTensor<float> lhs, LocalTensor<float> rhs, uint32_t count) {
        device::ComplexProducts<T>(work_buf_.Get<float>(), lhs, rhs, count);
    }

    __aicore__ inline void Probability(GlobalTensor<float> state, uint64_t base) {
        auto a = a_buf_.Get<float>();
        auto w = work_buf_.Get<float>();
        Load(state, a, base);
        Mul(w, a, a, size_);
        Mul(w[T], a[T], a[T], size_);
        PipeBarrier<PIPE_V>();
        Add(w, w, w[T], size_);
        PipeBarrier<PIPE_V>();
        ClearPadding(w);
    }

    __aicore__ inline float Sum(LocalTensor<float> source, uint32_t count) {
        auto scalar = scalar_buf_.Get<float>();
        // Balanced hardware reductions, never a scalar sum of amplitudes.
        Sync<HardEvent::S_V>();
        ReduceSum(scalar, source, work_buf_.Get<float>()[3 * T], count);
        Sync<HardEvent::V_S>();
        return scalar.GetValue(0);
    }

    __aicore__ inline void StorePartial(GlobalTensor<float> target, const CompensatedSum& real,
                                        const CompensatedSum& imag, uint64_t index) {
        auto record = partial_buf_.Get<float>();
        for (uint32_t i = 0; i < 8; ++i) {
            record.SetValue(i, 0.0F);
        }
        record.SetValue(0, real.sum);
        record.SetValue(1, imag.sum);
        record.SetValue(2, -real.error);
        record.SetValue(3, -imag.error);
        Sync<HardEvent::S_MTE3>();
        DataCopy(target[index * 8], record, 8);
        Sync<HardEvent::MTE3_S>();
    }

    TPipe pipe_;
    TBuf<TPosition::VECCALC> a_buf_, b_buf_, c_buf_, work_buf_, index_buf_, mask_buf_, scalar_buf_, partial_buf_;
    uint64_t dimension_, plane_;
    uint32_t size_;
};

class ObservableKernel : public TileMath {
 public:
    __aicore__ inline void Init(GM_ADDR ket, GM_ADDR bra, GM_ADDR output, GM_ADDR groups, GM_ADDR terms,
                                GM_ADDR indices, GM_ADDR signs, GM_ADDR rows, GM_ADDR columns, GM_ADDR values,
                                GM_ADDR partials, ObservableLayout layout) {
        InitMath(layout.dimension);
        layout_ = layout;
        ket_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ket));
        bra_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(bra));
        output_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output));
        indices_.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(indices));
        signs_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(signs));
        partials_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partials));
        groups_ = reinterpret_cast<__gm__ ObservableGroup*>(groups);
        terms_ = reinterpret_cast<__gm__ ObservableTerm*>(terms);
        rows_ = reinterpret_cast<__gm__ uint64_t*>(rows);
        columns_ = reinterpret_cast<__gm__ uint64_t*>(columns);
        values_ = reinterpret_cast<__gm__ ObservableValue*>(values);
        diagonal_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(values));
        write_ = output != nullptr;
        reduce_ = partials != nullptr;
    }

    __aicore__ inline void Run() {
        CompensatedSum real, imag;
        auto result = c_buf_.Get<float>();
        for (uint64_t base = static_cast<uint64_t>(GetBlockIdx()) * size_; base < plane_;
             base += static_cast<uint64_t>(GetBlockNum()) * size_) {
            Duplicate(result, 0.0F, size_);
            Duplicate(result[T], 0.0F, size_);
            PipeBarrier<PIPE_V>();
            if (layout_.kind == kObservablePauli) {
                Pauli(base);
            } else if (layout_.kind == kObservableDiagonal) {
                Diagonal(base);
            } else {
                Csr(base);
            }
            if (reduce_) {
                auto bra = a_buf_.Get<float>();
                Load(bra_, bra, base);
                Dot(bra, result, size_);
                auto w = work_buf_.Get<float>();
                ClearPadding(w);
                ClearPadding(w[2 * T]);
                real.AddValue(Sum(w, size_));
                imag.AddValue(Sum(w[2 * T], size_));
            }
            if (write_) {
                StoreState(output_, result, base);
            }
        }
        if (reduce_) {
            StorePartial(partials_, real, imag, GetBlockIdx());
        }
    }

 private:
    __aicore__ inline void Pauli(uint64_t base) {
        auto input = a_buf_.Get<float>();
        auto gathered = b_buf_.Get<float>();
        auto result = c_buf_.Get<float>();
        auto w = work_buf_.Get<float>();
        auto index = index_buf_.Get<uint32_t>();
        auto sign = mask_buf_.Get<float>();
        for (uint64_t g = 0; g < layout_.group_count; ++g) {
            const auto& group = groups_[g];
            // One contiguous source tile and one inverse-XOR Gather per
            // distinct flip mask, shared by every diagonal factor in the group.
            const auto source = base ^ (group.flip_mask & ~static_cast<uint64_t>(size_ - 1));
            Load(ket_, input, source);
            Sync<HardEvent::V_MTE2>();
            DataCopy(index, indices_[group.gather_offset], size_);
            Sync<HardEvent::MTE2_V>();
            Gather(gathered, input, index, 0, size_);
            Gather(gathered[T], input[T], index, 0, size_);
            PipeBarrier<PIPE_V>();
            for (uint64_t t = group.term_begin; t < group.term_begin + group.term_count; ++t) {
                const auto& term = terms_[t];
                Sync<HardEvent::V_MTE2>();
                DataCopy(sign, signs_[term.sign_offset], size_);
                Sync<HardEvent::MTE2_V>();
                Mul(w, gathered, sign, size_);
                Mul(w[T], gathered[T], sign, size_);
                PipeBarrier<PIPE_V>();
                const float high = Parity(base & term.parity_mask) ? -1.0F : 1.0F;
                const float re = high * term.coefficient.real, im = high * term.coefficient.imag;
                if (re != 0.0F) {
                    Axpy(result, w, re, size_);
                    Axpy(result[T], w[T], re, size_);
                    PipeBarrier<PIPE_V>();
                }
                if (im != 0.0F) {
                    Axpy(result, w[T], -im, size_);
                    Axpy(result[T], w, im, size_);
                    PipeBarrier<PIPE_V>();
                }
            }
        }
    }

    __aicore__ inline void Csr(uint64_t base) {
        auto input = a_buf_.Get<float>();
        auto coefficients = b_buf_.Get<float>();
        auto result = c_buf_.Get<float>();
        auto w = work_buf_.Get<float>();
        for (uint32_t row = 0; row < size_ && base + row < dimension_; ++row) {
            CompensatedSum re, im;
            const auto end = rows_[base + row + 1];
            for (uint64_t offset = rows_[base + row]; offset < end; offset += T) {
                const auto count = static_cast<uint32_t>(end - offset < T ? end - offset : T);
                // Irregular GM access only; complex multiplication and row
                // reduction are vectorized, even for duplicate column entries.
                Sync<HardEvent::V_S>();
                for (uint32_t i = 0; i < count; ++i) {
                    const auto column = columns_[offset + i];
                    input.SetValue(i, ket_.GetValue(column));
                    input.SetValue(T + i, ket_.GetValue(plane_ + column));
                    coefficients.SetValue(i, values_[offset + i].real);
                    coefficients.SetValue(T + i, values_[offset + i].imag);
                }
                Sync<HardEvent::S_V>();
                Mul(w, input, coefficients, count);
                Mul(w[T], input[T], coefficients[T], count);
                Mul(w[2 * T], input, coefficients[T], count);
                Mul(w[3 * T], input[T], coefficients, count);
                PipeBarrier<PIPE_V>();
                Sub(w, w, w[T], count);
                Add(w[2 * T], w[2 * T], w[3 * T], count);
                PipeBarrier<PIPE_V>();
                re.AddValue(Sum(w, count));
                im.AddValue(Sum(w[2 * T], count));
            }
            Sync<HardEvent::V_S>();
            result.SetValue(row, re.sum - re.error);
            result.SetValue(T + row, im.sum - im.error);
        }
        Sync<HardEvent::S_V>();
    }

    __aicore__ inline void Diagonal(uint64_t base) {
        auto input = a_buf_.Get<float>();
        auto coefficients = mask_buf_.Get<float>();
        auto result = c_buf_.Get<float>();
        Load(ket_, input, base);
        Sync<HardEvent::V_MTE2>();
        DataCopy(coefficients, diagonal_[base], size_);
        Sync<HardEvent::MTE2_V>();
        Mul(result, input, coefficients, size_);
        Mul(result[T], input[T], coefficients, size_);
        PipeBarrier<PIPE_V>();
    }

    GlobalTensor<float> ket_, bra_, output_, signs_, partials_, diagonal_;
    GlobalTensor<uint32_t> indices_;
    __gm__ ObservableGroup* groups_;
    __gm__ ObservableTerm* terms_;
    __gm__ uint64_t *rows_, *columns_;
    __gm__ ObservableValue* values_;
    ObservableLayout layout_;
    bool write_, reduce_;
};

class CompileDiagonalKernel : public TileMath {
 public:
    __aicore__ inline void Run(GM_ADDR terms, GM_ADDR signs, GM_ADDR diagonal, uint64_t term_count,
                               ObservableLayout layout) {
        InitMath(layout.dimension);
        auto metadata = reinterpret_cast<__gm__ ObservableTerm*>(terms);
        GlobalTensor<float> sign_pool, output;
        sign_pool.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(signs));
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(diagonal));
        auto sum = a_buf_.Get<float>();
        auto next = a_buf_.Get<float>()[T];
        auto error = b_buf_.Get<float>();
        auto adjusted = b_buf_.Get<float>()[T];
        auto sign = mask_buf_.Get<float>();
        for (uint64_t base = static_cast<uint64_t>(GetBlockIdx()) * size_; base < plane_;
             base += static_cast<uint64_t>(GetBlockNum()) * size_) {
            Duplicate(sum, 0.0F, size_);
            Duplicate(error, 0.0F, size_);
            PipeBarrier<PIPE_V>();
            for (uint64_t t = 0; t < term_count; ++t) {
                const auto& term = metadata[t];
                Sync<HardEvent::V_MTE2>();
                DataCopy(sign, sign_pool[term.sign_offset], size_);
                Sync<HardEvent::MTE2_V>();
                // base is tile-aligned, so only the high parity bits remain;
                // sign_pool supplies the same low-bit convention as Pauli().
                const float high = Parity(base & term.parity_mask) ? -1.0F : 1.0F;
                Muls(adjusted, sign, high * term.coefficient.real, size_);
                PipeBarrier<PIPE_V>();
                // Per-lane Kahan accumulation, matching CompensatedSum.
                Sub(adjusted, adjusted, error, size_);
                PipeBarrier<PIPE_V>();
                Add(next, sum, adjusted, size_);
                PipeBarrier<PIPE_V>();
                Sub(error, next, sum, size_);
                PipeBarrier<PIPE_V>();
                Sub(error, error, adjusted, size_);
                PipeBarrier<PIPE_V>();
                auto previous = sum;
                sum = next;
                next = previous;
            }
            Sub(sum, sum, error, size_);
            PipeBarrier<PIPE_V>();
            ClearPadding(sum);
            Sync<HardEvent::V_MTE3>();
            Sync<HardEvent::S_MTE3>();
            DataCopy(output[base], sum, size_);
            Sync<HardEvent::MTE3_V>();
            Sync<HardEvent::MTE3_S>();
        }
    }
};

class ReductionKernel : public TileMath {
 public:
    __aicore__ inline void Run(GM_ADDR bra, GM_ADDR ket, GM_ADDR partials, uint64_t dimension, uint64_t mask,
                               uint64_t value) {
        InitMath(dimension);
        GlobalTensor<float> left, right, output;
        left.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(bra));
        right.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ket));
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partials));
        const uint64_t low_mask = mask & (size_ - 1), high_mask = mask & ~static_cast<uint64_t>(size_ - 1);
        auto predicate = mask_buf_.Get<float>();
        for (uint32_t i = 0; i < size_; ++i) {
            predicate.SetValue(i, (i & low_mask) == (value & low_mask) ? 1.0F : 0.0F);
        }
        Sync<HardEvent::S_V>();
        CompensatedSum real, imag;
        auto w = work_buf_.Get<float>();
        for (uint64_t base = static_cast<uint64_t>(GetBlockIdx()) * size_; base < plane_;
             base += static_cast<uint64_t>(GetBlockNum()) * size_) {
            if ((base & high_mask) != (value & high_mask)) {
                continue;
            }
            if (bra == nullptr) {
                Probability(right, base);
            } else {
                Load(left, b_buf_.Get<float>(), base);
                Load(right, a_buf_.Get<float>(), base);
                Dot(b_buf_.Get<float>(), a_buf_.Get<float>(), size_);
            }
            if (low_mask) {
                Mul(w, w, predicate, size_);
                if (bra != nullptr) {
                    Mul(w[2 * T], w[2 * T], predicate, size_);
                }
                PipeBarrier<PIPE_V>();
            }
            ClearPadding(w);
            real.AddValue(Sum(w, size_));
            if (bra != nullptr) {
                ClearPadding(w[2 * T]);
                imag.AddValue(Sum(w[2 * T], size_));
            }
        }
        StorePartial(output, real, imag, GetBlockIdx());
    }
};

class DensityKernel : public TileMath {
 public:
    __aicore__ inline void Run(GM_ADDR state, GM_ADDR offsets, GM_ADDR indices, GM_ADDR partials,
                               DensityLayout layout) {
        InitMath(layout.dimension);
        layout_ = layout;
        state_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(state));
        routing_.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(indices));
        offsets_ = reinterpret_cast<__gm__ uint64_t*>(offsets);
        GlobalTensor<float> output;
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partials));
        const auto pairs = layout.output_dimension * layout.output_dimension;
        const auto tasks = pairs * layout.shards;
        for (uint64_t task = GetBlockIdx(); task < tasks; task += GetBlockNum()) {
            const auto pair = task / layout.shards;
            const auto row = Deposit(pair / layout.output_dimension, layout.kept_mask);
            const auto column = Deposit(pair % layout.output_dimension, layout.kept_mask);
            CompensatedSum real, imag;
            for (uint64_t tile = task % layout.shards; tile < layout.tile_count; tile += layout.shards) {
                const auto base = Deposit(tile, layout.external_mask);
                LoadRow(base, row, b_buf_.Get<float>());
                LoadRow(base, column, c_buf_.Get<float>());
                // rho[row,column] = psi[row] * conj(psi[column]).
                Dot(c_buf_.Get<float>(), b_buf_.Get<float>(), layout.environment_size);
                real.AddValue(Sum(work_buf_.Get<float>(), layout.environment_size));
                imag.AddValue(Sum(work_buf_.Get<float>()[2 * T], layout.environment_size));
            }
            StorePartial(output, real, imag, task);
        }
    }

 private:
    __aicore__ inline void LoadRow(uint64_t base, uint64_t kept, LocalTensor<float> row) {
        auto input = a_buf_.Get<float>();
        auto index = index_buf_.Get<uint32_t>();
        Sync<HardEvent::V_MTE2>();
        const auto stride = layout_.environment_size < 8 ? 8 : layout_.environment_size;
        DataCopy(index, routing_[(kept & 7) * stride], stride);
        for (uint32_t offset = 0; offset < layout_.packet_size; offset += layout_.run) {
            const auto global = base | (kept & ~uint64_t{7}) | offsets_[offset / layout_.run];
            DataCopy(input[offset], state_[global], layout_.run);
            DataCopy(input[T + offset], state_[plane_ + global], layout_.run);
        }
        Sync<HardEvent::MTE2_V>();
        Gather(row, input, index, 0, layout_.environment_size);
        Gather(row[T], input[T], index, 0, layout_.environment_size);
        PipeBarrier<PIPE_V>();
    }

    GlobalTensor<float> state_;
    GlobalTensor<uint32_t> routing_;
    __gm__ uint64_t* offsets_;
    DensityLayout layout_;
};

class TransformKernel : public TileMath {
 public:
    __aicore__ inline void Run(GM_ADDR state, uint64_t dimension, uint64_t bit, uint32_t outcome, uint32_t target,
                               float factor) {
        InitMath(dimension);
        GlobalTensor<float> global;
        global.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(state));
        auto input = a_buf_.Get<float>();
        auto output = b_buf_.Get<float>();
        auto predicate = mask_buf_.Get<float>();
        auto indices = index_buf_.Get<uint32_t>();
        if (bit && bit < size_) {
            for (uint32_t i = 0; i < size_; ++i) {
                indices.SetValue(i, ((i & ~bit) | (outcome ? bit : 0)) * sizeof(float));
                predicate.SetValue(i, static_cast<bool>(i & bit) == static_cast<bool>(target) ? factor : 0.0F);
            }
            Sync<HardEvent::S_V>();
        }
        if (bit >= size_) {
            Duplicate(output, 0.0F, size_);
            Duplicate(output[T], 0.0F, size_);
            PipeBarrier<PIPE_V>();
        }
        const uint64_t tasks = bit >= size_ ? plane_ / (2 * size_) : plane_ / size_;
        for (uint64_t task = GetBlockIdx(); task < tasks; task += GetBlockNum()) {
            uint64_t base = task * size_;
            if (bit >= size_) {
                // Deposit a zero at the measured high bit. Only this core
                // owns BOTH tiles; no other core can overwrite our input.
                base = (base & (bit - 1)) | ((base & ~(bit - 1)) << 1);
                Load(global, input, base | (outcome ? bit : 0));
                Muls(input, input, factor, size_);
                Muls(input[T], input[T], factor, size_);
                PipeBarrier<PIPE_V>();
                StoreState(global, input, base | (target ? bit : 0));
                StoreState(global, output, base | (target ? 0 : bit));
            } else {
                Load(global, input, base);
                if (bit) {
                    Gather(output, input, indices, 0, size_);
                    Gather(output[T], input[T], indices, 0, size_);
                    PipeBarrier<PIPE_V>();
                    Mul(output, output, predicate, size_);
                    Mul(output[T], output[T], predicate, size_);
                    PipeBarrier<PIPE_V>();
                    StoreState(global, output, base);
                } else {
                    Muls(input, input, factor, size_);
                    Muls(input[T], input[T], factor, size_);
                    PipeBarrier<PIPE_V>();
                    StoreState(global, input, base);
                }
            }
        }
    }
};

class SamplingKernel : public TileMath {
 public:
    __aicore__ inline void Init(GM_ADDR state, GM_ADDR tree, SamplingLayout layout) {
        InitMath(layout.dimension);
        layout_ = layout;
        state_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(state));
        tree_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(tree));
    }

    __aicore__ inline void Build(GM_ADDR totals) {
        GlobalTensor<float> output;
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(totals));
        const uint64_t leaves = layout_.tiles_per_bin;
        const uint64_t tree_base = 2 * GetBlockIdx() * leaves;
        auto stage = c_buf_.Get<float>();
        for (uint64_t begin = 0; begin < leaves; begin += T) {
            const auto count = static_cast<uint32_t>(leaves - begin < T ? leaves - begin : T);
            for (uint32_t i = 0; i < count; ++i) {
                const uint64_t base = (GetBlockIdx() * leaves + begin + i) * T;
                float mass = 0.0F;
                if (base < dimension_) {
                    Probability(state_, base);
                    mass = Sum(work_buf_.Get<float>(), size_);
                }
                stage.SetValue(i, mass);
            }
            StoreTree(tree_base + leaves + begin, stage, count);
        }

        auto index = index_buf_.Get<uint32_t>();
        for (uint32_t i = 0; i < T; ++i) {
            index.SetValue(i, 2 * i * sizeof(float));
            index.SetValue(T + i, (2 * i + 1) * sizeof(float));
        }
        Sync<HardEvent::S_V>();
        auto input = b_buf_.Get<float>();
        auto w = work_buf_.Get<float>();
        float root = 0.0F;
        // One core owns a whole bin. Each level is completed before the next
        // reads it, so no cross-core barrier or global atomic sum is needed.
        for (uint64_t width = leaves / 2; width; width /= 2) {
            for (uint64_t begin = 0; begin < width; begin += T) {
                const auto count = static_cast<uint32_t>(width - begin < T ? width - begin : T);
                Sync<HardEvent::V_MTE2>();
                DataCopyPad(input, tree_[tree_base + 2 * (width + begin)],
                            DataCopyExtParams{1, 2 * count * static_cast<uint32_t>(sizeof(float)), 0, 0, 0},
                            DataCopyPadExtParams<float>{false, 0, 0, 0});
                Sync<HardEvent::MTE2_V>();
                Gather(w, input, index, 0, count);
                Gather(w[T], input, index[T], 0, count);
                PipeBarrier<PIPE_V>();
                Add(stage[T], w, w[T], count);
                PipeBarrier<PIPE_V>();
                if (width == 1) {
                    Sync<HardEvent::V_S>();
                    root = stage.GetValue(T);
                }
                StoreTree(tree_base + width + begin, stage[T], count);
            }
        }
        CompensatedSum real, imag;
        real.sum = root;
        StorePartial(output, real, imag, GetBlockIdx());
    }

    __aicore__ inline void Sample(GM_ADDR requests, GM_ADDR results, uint64_t shots) {
        auto queries = reinterpret_cast<__gm__ SamplingRequest*>(requests);
        GlobalTensor<uint64_t> output;
        output.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(results));
        auto record = partial_buf_.Get<uint64_t>();
        for (uint64_t shot = GetBlockIdx(); shot < shots; shot += GetBlockNum()) {
            const auto bin = queries[shot].bin;
            const float fraction = queries[shot].fraction;
            uint64_t selected = kInvalidSampleIndex;
            if (bin < layout_.bins && fraction >= 0.0F && fraction < 1.0F) {
                selected = Search(bin, fraction);
            }
            record.SetValue(0, selected);
            record.SetValue(1, 0);
            record.SetValue(2, 0);
            record.SetValue(3, 0);
            Sync<HardEvent::S_MTE3>();
            DataCopy(output[shot * 4], record, 4);
            Sync<HardEvent::MTE3_S>();
        }
    }

 private:
    __aicore__ inline void StoreTree(uint64_t offset, LocalTensor<float> source, uint32_t count) {
        Sync<HardEvent::V_MTE3>();
        Sync<HardEvent::S_MTE3>();
        // The top three levels have fewer than eight floats. Exact byte DMA
        // avoids both overreading another bin and overwriting sibling nodes.
        DataCopyPad(tree_[offset], source, DataCopyExtParams{1, count * static_cast<uint32_t>(sizeof(float)), 0, 0, 0});
        Sync<HardEvent::MTE3_S>();
        Sync<HardEvent::MTE3_V>();
        Sync<HardEvent::MTE3_MTE2>();
    }

    __aicore__ inline bool GoLeft(float left, float right, float& target) {
        if (left > 0.0F && (target < left || !(right > 0.0F))) {
            return true;
        }
        target -= left;
        return false;
    }

    __aicore__ inline uint64_t Search(uint32_t bin, float fraction) {
        const uint64_t leaves = layout_.tiles_per_bin;
        const uint64_t base = 2 * bin * leaves;
        const float root = tree_.GetValue(base + 1);
        if (!(root > 0.0F)) {
            return kInvalidSampleIndex;
        }
        float target = fraction * root;
        uint64_t node = 1;
        while (node < leaves) {
            const float left = tree_.GetValue(base + 2 * node);
            const float right = tree_.GetValue(base + 2 * node + 1);
            node = 2 * node + (GoLeft(left, right, target) ? 0 : 1);
        }
        const uint64_t state_base = (bin * leaves + node - leaves) * T;
        if (state_base >= dimension_) {
            return kInvalidSampleIndex;
        }
        Probability(state_, state_base);
        auto probabilities = work_buf_.Get<float>();
        uint32_t start = 0, width = size_;
        while (width > 8) {
            width /= 2;
            const float left = Sum(probabilities[start], width);
            const float right = Sum(probabilities[start + width], width);
            if (!GoLeft(left, right, target)) {
                start += width;
            }
        }
        Sync<HardEvent::V_S>();
        uint64_t last_positive = kInvalidSampleIndex;
        for (uint32_t i = start; i < start + width && state_base + i < dimension_; ++i) {
            const float mass = probabilities.GetValue(i);
            if (mass > 0.0F) {
                last_positive = state_base + i;
                if (target < mass) {
                    return last_positive;
                }
                target -= mass;
            }
        }
        return last_positive;  // inclusive rounding at the right endpoint
    }

    GlobalTensor<float> state_, tree_;
    SamplingLayout layout_;
};
}  // namespace

extern "C" __global__ __aicore__ void mq_ascend_observable(GM_ADDR ket, GM_ADDR bra, GM_ADDR output, GM_ADDR groups,
                                                           GM_ADDR terms, GM_ADDR indices, GM_ADDR signs, GM_ADDR rows,
                                                           GM_ADDR columns, GM_ADDR values, GM_ADDR partials,
                                                           ObservableLayout layout) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    ObservableKernel kernel;
    kernel.Init(ket, bra, output, groups, terms, indices, signs, rows, columns, values, partials, layout);
    kernel.Run();
}

extern "C" __global__ __aicore__ void mq_ascend_compile_diagonal(GM_ADDR terms, GM_ADDR signs, GM_ADDR diagonal,
                                                                 uint64_t term_count, ObservableLayout layout) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    CompileDiagonalKernel kernel;
    kernel.Run(terms, signs, diagonal, term_count, layout);
}

extern "C" __global__ __aicore__ void mq_ascend_inner_product(GM_ADDR bra, GM_ADDR ket, GM_ADDR partials,
                                                              uint64_t dimension, uint64_t mask, uint64_t value) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    ReductionKernel kernel;
    kernel.Run(bra, ket, partials, dimension, mask, value);
}

extern "C" __global__ __aicore__ void mq_ascend_transform(GM_ADDR state, uint64_t dimension, uint64_t bit,
                                                          uint32_t outcome, uint32_t target, float factor) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TransformKernel kernel;
    kernel.Run(state, dimension, bit, outcome, target, factor);
}

extern "C" __global__ __aicore__ void mq_ascend_density(GM_ADDR state, GM_ADDR offsets, GM_ADDR indices,
                                                        GM_ADDR partials, DensityLayout layout) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    DensityKernel kernel;
    kernel.Run(state, offsets, indices, partials, layout);
}

extern "C" __global__ __aicore__ void mq_ascend_sampling_tree(GM_ADDR state, GM_ADDR tree, GM_ADDR totals,
                                                              SamplingLayout layout) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    SamplingKernel kernel;
    kernel.Init(state, tree, layout);
    kernel.Build(totals);
}

extern "C" __global__ __aicore__ void mq_ascend_sample(GM_ADDR state, GM_ADDR tree, GM_ADDR requests, GM_ADDR results,
                                                       uint64_t shots, SamplingLayout layout) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    SamplingKernel kernel;
    kernel.Init(state, tree, layout);
    kernel.Sample(requests, results, shots);
}

namespace mindquantum::sim::ascend {
namespace {
bool ValidShape(uint32_t blocks, uint64_t dimension) {
    return blocks > 0 && blocks <= kObservableMaxBlocks && dimension > 0 && dimension <= (uint64_t{1} << 32)
           && (dimension & (dimension - 1)) == 0;
}

bool Finite(float value) {
    uint32_t bits;
    __builtin_memcpy(&bits, &value, sizeof(bits));
    return (bits & 0x7f800000U) != 0x7f800000U;
}

bool ValidSampling(SamplingLayout layout) {
    if (!ValidShape(layout.bins, layout.dimension) || layout.plane != (layout.dimension < 8 ? 8 : layout.dimension)) {
        return false;
    }
    const auto tiles = (layout.plane + T - 1) / T;
    const auto required = (tiles + layout.bins - 1) / layout.bins;
    uint32_t leaves = 8;
    while (leaves < required) {
        leaves <<= 1;
    }
    return layout.tiles_per_bin == leaves;
}
}  // namespace

aclError LaunchObservable(uint32_t blocks, aclrtStream stream, void* ket, void* bra, void* output, void* groups,
                          void* terms, void* gather_indices, void* signs, void* row_offsets, void* columns,
                          void* values, void* partials, ObservableLayout layout) {
    const uint64_t plane = layout.dimension < 8 ? 8 : layout.dimension;
    if (!ValidShape(blocks, layout.dimension) || layout.plane != plane || layout.tile_size != (plane < T ? plane : T)
        || !ket || (!output && !partials) || (partials && !bra) || (output && (output == ket || output == bra))
        || (layout.kind != kObservablePauli && layout.kind != kObservableCsr && layout.kind != kObservableDiagonal)
        || (layout.kind == kObservablePauli && layout.group_count && (!groups || !terms || !gather_indices || !signs))
        || (layout.kind == kObservableCsr && !row_offsets)
        || (layout.kind == kObservableDiagonal && (!values || output == values || partials == values))) {
        return ACL_ERROR_INVALID_PARAM;
    }
    mq_ascend_observable<<<blocks, nullptr, stream>>>(
        static_cast<uint8_t*>(ket), static_cast<uint8_t*>(bra), static_cast<uint8_t*>(output),
        static_cast<uint8_t*>(groups), static_cast<uint8_t*>(terms), static_cast<uint8_t*>(gather_indices),
        static_cast<uint8_t*>(signs), static_cast<uint8_t*>(row_offsets), static_cast<uint8_t*>(columns),
        static_cast<uint8_t*>(values), static_cast<uint8_t*>(partials), layout);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

aclError LaunchCompileDiagonal(uint32_t blocks, aclrtStream stream, void* terms, void* signs, void* diagonal,
                               uint64_t term_count, ObservableLayout layout) {
    const uint64_t plane = layout.dimension < 8 ? 8 : layout.dimension;
    if (!ValidShape(blocks, layout.dimension) || layout.plane != plane || layout.tile_size != (plane < T ? plane : T)
        || (layout.kind != kObservablePauli && layout.kind != kObservableDiagonal) || !diagonal
        || (term_count && (!terms || !signs)) || term_count > UINT64_MAX / sizeof(ObservableTerm) || diagonal == terms
        || diagonal == signs) {
        return ACL_ERROR_INVALID_PARAM;
    }
    mq_ascend_compile_diagonal<<<blocks, nullptr, stream>>>(static_cast<uint8_t*>(terms), static_cast<uint8_t*>(signs),
                                                            static_cast<uint8_t*>(diagonal), term_count, layout);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

aclError LaunchInnerProduct(uint32_t blocks, aclrtStream stream, void* bra, void* ket, void* partials,
                            uint64_t dimension, uint64_t mask, uint64_t value) {
    if (!ValidShape(blocks, dimension) || !ket || !partials || (mask & ~(dimension - 1)) || (value & ~mask)) {
        return ACL_ERROR_INVALID_PARAM;
    }
    mq_ascend_inner_product<<<blocks, nullptr, stream>>>(static_cast<uint8_t*>(bra), static_cast<uint8_t*>(ket),
                                                         static_cast<uint8_t*>(partials), dimension, mask, value);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

aclError LaunchCollapse(uint32_t blocks, aclrtStream stream, void* state, uint64_t dimension, uint32_t qubit,
                        uint32_t outcome, int32_t reset_to, float inverse_norm) {
    if (!ValidShape(blocks, dimension) || !state || qubit >= 32 || (uint64_t{1} << qubit) >= dimension || outcome > 1
        || reset_to < -1 || reset_to > 1 || !Finite(inverse_norm) || inverse_norm <= 0.0F) {
        return ACL_ERROR_INVALID_PARAM;
    }
    const uint32_t target = reset_to < 0 ? outcome : static_cast<uint32_t>(reset_to);
    mq_ascend_transform<<<blocks, nullptr, stream>>>(static_cast<uint8_t*>(state), dimension, uint64_t{1} << qubit,
                                                     outcome, target, inverse_norm);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

aclError LaunchScale(uint32_t blocks, aclrtStream stream, void* state, uint64_t dimension, float factor) {
    if (!ValidShape(blocks, dimension) || !state || !Finite(factor)) {
        return ACL_ERROR_INVALID_PARAM;
    }
    mq_ascend_transform<<<blocks, nullptr, stream>>>(static_cast<uint8_t*>(state), dimension, 0, 0, 0, factor);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

aclError LaunchDensity(uint32_t blocks, aclrtStream stream, void* state, void* offsets, void* indices, void* partials,
                       DensityLayout layout) {
    mq_ascend_density<<<blocks, nullptr, stream>>>(static_cast<uint8_t*>(state), static_cast<uint8_t*>(offsets),
                                                   static_cast<uint8_t*>(indices), static_cast<uint8_t*>(partials),
                                                   layout);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

aclError LaunchSamplingTree(uint32_t blocks, aclrtStream stream, void* state, void* tree, void* totals,
                            SamplingLayout layout) {
    if (!ValidSampling(layout) || blocks != layout.bins || !state || !tree || !totals) {
        return ACL_ERROR_INVALID_PARAM;
    }
    mq_ascend_sampling_tree<<<blocks, nullptr, stream>>>(static_cast<uint8_t*>(state), static_cast<uint8_t*>(tree),
                                                         static_cast<uint8_t*>(totals), layout);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

aclError LaunchSample(uint32_t blocks, aclrtStream stream, void* state, void* tree, void* requests, void* results,
                      uint64_t shots, SamplingLayout layout) {
    if (!ValidSampling(layout) || !ValidShape(blocks, layout.dimension) || !state || !tree
        || (shots && (!requests || !results)) || shots > UINT64_MAX / sizeof(SamplingResult)) {
        return ACL_ERROR_INVALID_PARAM;
    }
    mq_ascend_sample<<<blocks, nullptr, stream>>>(static_cast<uint8_t*>(state), static_cast<uint8_t*>(tree),
                                                  static_cast<uint8_t*>(requests), static_cast<uint8_t*>(results),
                                                  shots, layout);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
}  // namespace mindquantum::sim::ascend
