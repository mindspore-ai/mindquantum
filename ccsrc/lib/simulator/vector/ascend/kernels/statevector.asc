#include <acl/acl.h>

#include "kernel_operator.h"
#include "simulator/vector/ascend/device_program.h"
#include "simulator/vector/ascend/kernel_launch.h"
#include "tile_executor.inc"

using namespace AscendC;                   // NOLINT
using namespace mindquantum::sim::ascend;  // NOLINT

namespace {
class TileKernel {
 public:
    __aicore__ inline void Init(GM_ADDR state, GM_ADDR instructions, GM_ADDR data, GM_ADDR offsets, uint64_t plane,
                                uint64_t external_mask, uint32_t tile_size, uint32_t run, uint32_t instruction_count) {
        state_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(state));
        offsets_ = reinterpret_cast<__gm__ uint64_t*>(offsets);
        instructions_ = reinterpret_cast<__gm__ Instruction*>(instructions);
        plane_ = plane;
        external_mask_ = external_mask;
        size_ = tile_size;
        run_ = run;
        count_ = instruction_count;
        pipe_.InitBuffer(state_buf_, 4 * kMaxTileSize * sizeof(float));
        executor_.Init(pipe_, data, tile_size);
    }

    __aicore__ inline void Run(uint64_t tiles) {
        if (GetBlockIdx() >= tiles) {
            return;
        }
        const auto step = GetBlockNum();
        LoadState(GetBlockIdx(), 0, false);
        uint32_t iteration = 0;
        for (uint64_t tile = GetBlockIdx(); tile < tiles; tile += step, ++iteration) {
            const auto slot = iteration & 1U;
            WaitFlag<HardEvent::MTE2_V>(static_cast<event_t>(EVENT_ID2 + slot));
            // Preserve the evolution engine's two-slot DMA/Vector overlap.
            if (tile + step < tiles) {
                LoadState(tile + step, slot ^ 1U, iteration != 0);
            }
            auto state = state_buf_.Get<float>()[slot * 2 * kMaxTileSize];
            const auto base = device::Deposit(tile, external_mask_);
            for (uint32_t i = 0; i < count_; ++i) {
                const auto& op = instructions_[i];
                if (device::Matches(op, base)) {
                    executor_.Apply(op, state);
                }
            }
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            for (uint32_t offset = 0; offset < size_; offset += run_) {
                const auto global = base | offsets_[offset / run_];
                DataCopy(state_[global], state[offset], run_);
                DataCopy(state_[plane_ + global], state[kMaxTileSize + offset], run_);
            }
            SetFlag<HardEvent::MTE3_MTE2>(static_cast<event_t>(EVENT_ID2 + slot));
        }
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID2);
        if (iteration > 1) {
            WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID3);
        }
    }

 private:
    __aicore__ inline void LoadState(uint64_t tile, uint32_t slot, bool reuse) {
        const auto event = static_cast<event_t>(EVENT_ID2 + slot);
        if (reuse) {
            WaitFlag<HardEvent::MTE3_MTE2>(event);
        }
        auto state = state_buf_.Get<float>()[slot * 2 * kMaxTileSize];
        const auto base = device::Deposit(tile, external_mask_);
        for (uint32_t offset = 0; offset < size_; offset += run_) {
            const auto global = base | offsets_[offset / run_];
            DataCopy(state[offset], state_[global], run_);
            DataCopy(state[kMaxTileSize + offset], state_[plane_ + global], run_);
        }
        SetFlag<HardEvent::MTE2_V>(event);
    }

    TPipe pipe_;
    TBuf<TPosition::VECCALC> state_buf_;
    device::TileExecutor<kMaxTileSize> executor_;
    GlobalTensor<float> state_;
    __gm__ Instruction* instructions_;
    __gm__ uint64_t* offsets_;
    uint64_t plane_, external_mask_;
    uint32_t size_, run_, count_;
};
}  // namespace

extern "C" __global__ __aicore__ void mq_ascend_tile(GM_ADDR state, GM_ADDR instructions, GM_ADDR data, GM_ADDR offsets,
                                                     uint64_t plane, uint64_t external_mask, uint64_t tiles,
                                                     uint32_t size, uint32_t run, uint32_t count) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TileKernel kernel;
    kernel.Init(state, instructions, data, offsets, plane, external_mask, size, run, count);
    kernel.Run(tiles);
}

extern "C" __global__ __aicore__ void mq_ascend_reset(GM_ADDR state, uint64_t plane) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, kMaxTileSize * sizeof(float));
    auto zeros = buffer.Get<float>();
    Duplicate(zeros, 0.0F, kMaxTileSize);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    GlobalTensor<float> output;
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(state));
    const auto length = plane * 2;
    for (uint64_t offset = GetBlockIdx() * kMaxTileSize; offset < length; offset += GetBlockNum() * kMaxTileSize) {
        const auto count = static_cast<uint32_t>(length - offset < kMaxTileSize ? length - offset : kMaxTileSize);
        DataCopy(output[offset], zeros, count);
    }
    if (GetBlockIdx() == 0) {
        SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
        zeros.SetValue(0, 1.0F);
        SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
        DataCopy(output, zeros, 8);
    }
}

namespace mindquantum::sim::ascend {
aclError LaunchTile(uint32_t blocks, aclrtStream stream, void* state, void* instructions, void* data, void* offsets,
                    uint64_t plane, uint64_t external_mask, uint64_t tiles, uint32_t size, uint32_t run,
                    uint32_t count) {
    mq_ascend_tile<<<blocks, nullptr, stream>>>(static_cast<uint8_t*>(state), static_cast<uint8_t*>(instructions),
                                                static_cast<uint8_t*>(data), static_cast<uint8_t*>(offsets), plane,
                                                external_mask, tiles, size, run, count);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

aclError LaunchReset(uint32_t blocks, aclrtStream stream, void* state, uint64_t plane) {
    mq_ascend_reset<<<blocks, nullptr, stream>>>(static_cast<uint8_t*>(state), plane);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
}  // namespace mindquantum::sim::ascend
