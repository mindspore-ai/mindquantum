#include <acl/acl.h>

#include "kernel_operator.h"
#include "simulator/vector/ascend/kernel_launch.h"
#include "tile_executor.inc"

using namespace AscendC;                   // NOLINT
using namespace mindquantum::sim::ascend;  // NOLINT

namespace {
constexpr uint32_t Capacity = kMaxAdjointTileSize;
using device::CompensatedSum;
using device::Complex;

class AdjointKernel {
 public:
    __aicore__ inline void Init(GM_ADDR shared, GM_ADDR costate, GM_ADDR instructions, GM_ADDR data, GM_ADDR offsets,
                                GM_ADDR steps, GM_ADDR derivatives, GM_ADDR targets, GM_ADDR partials, uint64_t plane,
                                uint64_t external_mask, uint32_t size, uint32_t run, uint32_t step_count,
                                uint32_t output_size) {
        shared_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(shared));
        costate_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(costate));
        instructions_ = reinterpret_cast<__gm__ Instruction*>(instructions);
        offsets_ = reinterpret_cast<__gm__ uint64_t*>(offsets);
        steps_ = reinterpret_cast<__gm__ AdjointStep*>(steps);
        derivatives_ = reinterpret_cast<__gm__ AdjointDerivative*>(derivatives);
        targets_ = reinterpret_cast<__gm__ GradientTarget*>(targets);
        plane_ = plane;
        external_mask_ = external_mask;
        size_ = size;
        run_ = run;
        count_ = step_count;
        // Two resident state pairs share each derivative's partial update.
        // Including executor and reduction scratch, UB stays below 192 KiB.
        pipe_.InitBuffer(states_buf_, 10 * Capacity * sizeof(float));
        reduction_.Init(pipe_, size);
        sums_.Init(pipe_, partials, output_size);
        executor_.Init(pipe_, data, size);
    }

    __aicore__ inline void Run(uint64_t tiles, bool compute_overlap) {
        if (GetBlockIdx() >= tiles) {
            return;
        }
        const auto stride = GetBlockNum();
        CompensatedSum overlap_real, overlap_imag;
        for (uint64_t tile = GetBlockIdx(); tile < tiles; tile += 2 * stride) {
            const uint32_t count = tile + stride < tiles ? 2 : 1;
            uint64_t bases[2];
            for (uint32_t slot = 0; slot < count; ++slot) {
                bases[slot] = device::Deposit(tile + slot * stride, external_mask_);
                Load(bases[slot], slot, tile != GetBlockIdx());
            }
            for (uint32_t slot = 0; slot < count; ++slot) {
                WaitFlag<HardEvent::MTE2_V>(static_cast<event_t>(EVENT_ID2 + slot));
                if (compute_overlap) {
                    auto shared = states_buf_.Get<float>()[slot * 4 * Capacity];
                    const auto value = reduction_.Dot(shared, shared[2 * Capacity]);
                    overlap_real.AddValue(value.real);
                    overlap_imag.AddValue(value.imag);
                }
            }
            for (uint32_t index = 0; index < count_; ++index) {
                const auto& step = steps_[index];
                for (uint32_t slot = 0; slot < count; ++slot) {
                    Evolve(step, bases[slot], states_buf_.Get<float>()[slot * 4 * Capacity],
                           step.derivative_count ? 1U : 2U);
                }
                for (uint32_t d = 0; d < step.derivative_count; ++d) {
                    const auto& derivative = derivatives_[step.derivative_begin + d];
                    CompensatedSum real, imag;
                    for (uint32_t slot = 0; slot < count; ++slot) {
                        const auto value = Contract(derivative, bases[slot],
                                                    states_buf_.Get<float>()[slot * 4 * Capacity]);
                        real.AddValue(value.real);
                        imag.AddValue(value.imag);
                    }
                    // The Jacobian is shared by all spatial tiles. Apply it
                    // after contraction, without storage proportional to targets.
                    for (uint32_t t = 0; t < derivative.target_count; ++t) {
                        const auto& target = targets_[derivative.target_begin + t];
                        sums_.Add(target.output_index,
                                  {real.sum * target.real - imag.sum * target.imag,
                                   real.sum * target.imag + imag.sum * target.real},
                                  {-real.error * target.real + imag.error * target.imag,
                                   -real.error * target.imag - imag.error * target.real});
                    }
                }
                if (step.derivative_count) {
                    for (uint32_t slot = 0; slot < count; ++slot) {
                        Evolve(step, bases[slot], states_buf_.Get<float>()[(slot * 4 + 2) * Capacity], 1);
                    }
                }
            }
            for (uint32_t slot = 0; slot < count; ++slot) {
                Store(bases[slot], slot);
            }
        }
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID2);
        if (GetBlockIdx() + stride < tiles) {
            WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID3);
        }
        if (compute_overlap) {
            sums_.Add(0, {overlap_real.sum, overlap_imag.sum}, {-overlap_real.error, -overlap_imag.error});
        }
    }

 private:
    __aicore__ inline Complex Contract(const __gm__ AdjointDerivative& derivative, uint64_t base,
                                       LocalTensor<float> shared) {
        auto costate = shared[2 * Capacity];
        auto scratch = states_buf_.Get<float>()[8 * Capacity];
        Complex intrinsic{0.0F, 0.0F};
        for (uint32_t i = 0; i < derivative.instruction_count; ++i) {
            const auto& op = instructions_[derivative.instruction_begin + i];
            if (!device::Matches(op, base)) {
                continue;  // Inactive controls/parity contribute ZERO.
            }
            Adds(scratch, costate, 0.0F, size_);
            Adds(scratch[Capacity], costate[Capacity], 0.0F, size_);
            PipeBarrier<PIPE_V>();
            executor_.Apply(op, scratch);
            const auto part = reduction_.Dot(shared, scratch);
            intrinsic.real += part.real;
            intrinsic.imag += part.imag;
        }
        return intrinsic;
    }

    __aicore__ inline void Store(uint64_t base, uint32_t slot) {
        auto shared = states_buf_.Get<float>()[slot * 4 * Capacity];
        auto costate = shared[2 * Capacity];
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        for (uint32_t offset = 0; offset < size_; offset += run_) {
            const auto global = base | offsets_[offset / run_];
            DataCopy(shared_[global], shared[offset], run_);
            DataCopy(shared_[plane_ + global], shared[Capacity + offset], run_);
            DataCopy(costate_[global], costate[offset], run_);
            DataCopy(costate_[plane_ + global], costate[Capacity + offset], run_);
        }
        SetFlag<HardEvent::MTE3_MTE2>(static_cast<event_t>(EVENT_ID2 + slot));
    }

    __aicore__ inline void Load(uint64_t base, uint32_t slot, bool reuse) {
        const auto event = static_cast<event_t>(EVENT_ID2 + slot);
        if (reuse) {
            WaitFlag<HardEvent::MTE3_MTE2>(event);
        }
        auto shared = states_buf_.Get<float>()[slot * 4 * Capacity];
        auto costate = shared[2 * Capacity];
        for (uint32_t offset = 0; offset < size_; offset += run_) {
            const auto global = base | offsets_[offset / run_];
            DataCopy(shared[offset], shared_[global], run_);
            DataCopy(shared[Capacity + offset], shared_[plane_ + global], run_);
            DataCopy(costate[offset], costate_[global], run_);
            DataCopy(costate[Capacity + offset], costate_[plane_ + global], run_);
        }
        SetFlag<HardEvent::MTE2_V>(event);
    }

    __aicore__ inline void Evolve(const __gm__ AdjointStep& step, uint64_t base, LocalTensor<float> state,
                                  uint32_t count) {
        for (uint32_t i = 0; i < step.evolution_count; ++i) {
            const auto& op = instructions_[step.evolution_begin + i];
            if (device::Matches(op, base)) {
                executor_.Apply(op, state, count);
            }
        }
    }

    TPipe pipe_;
    TBuf<TPosition::VECCALC> states_buf_;
    device::TileExecutor<Capacity> executor_;
    device::InnerProduct<Capacity> reduction_;
    device::PartialSums sums_;
    GlobalTensor<float> shared_, costate_;
    __gm__ Instruction* instructions_;
    __gm__ uint64_t* offsets_;
    __gm__ AdjointStep* steps_;
    __gm__ AdjointDerivative* derivatives_;
    __gm__ GradientTarget* targets_;
    uint64_t plane_, external_mask_;
    uint32_t size_, run_, count_;
};
}  // namespace

extern "C" __global__ __aicore__ void mq_ascend_adjoint(GM_ADDR shared, GM_ADDR costate, GM_ADDR instructions,
                                                        GM_ADDR data, GM_ADDR offsets, GM_ADDR steps,
                                                        GM_ADDR derivatives, GM_ADDR targets, GM_ADDR partials,
                                                        uint64_t plane, uint64_t external_mask, uint64_t tiles,
                                                        uint32_t size, uint32_t run, uint32_t step_count,
                                                        uint32_t output_size, uint32_t compute_overlap) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    AdjointKernel kernel;
    kernel.Init(shared, costate, instructions, data, offsets, steps, derivatives, targets, partials, plane,
                external_mask, size, run, step_count, output_size);
    kernel.Run(tiles, compute_overlap != 0);
}

namespace mindquantum::sim::ascend {
aclError LaunchAdjointTile(uint32_t blocks, aclrtStream stream, void* shared_state, void* costate, void* instructions,
                           void* data, void* offsets, void* steps, void* derivatives, void* targets, void* partials,
                           uint64_t plane, uint64_t external_mask, uint64_t tiles, uint32_t size, uint32_t run,
                           uint32_t step_count, uint32_t output_size, uint32_t compute_overlap) {
    mq_ascend_adjoint<<<blocks, nullptr, stream>>>(
        static_cast<uint8_t*>(shared_state), static_cast<uint8_t*>(costate), static_cast<uint8_t*>(instructions),
        static_cast<uint8_t*>(data), static_cast<uint8_t*>(offsets), static_cast<uint8_t*>(steps),
        static_cast<uint8_t*>(derivatives), static_cast<uint8_t*>(targets), static_cast<uint8_t*>(partials), plane,
        external_mask, tiles, size, run, step_count, output_size, compute_overlap);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
}  // namespace mindquantum::sim::ascend
