#include <acl/acl.h>

#include "kernel_operator.h"
#include "simulator/vector/ascend/kernel_launch.h"
#include "simulator/vector/ascend/tile_executor.h"

using namespace AscendC;                   // NOLINT
using namespace mindquantum::sim::ascend;  // NOLINT

namespace {
constexpr uint32_t Capacity = kMaxAdjointTileSize;
struct Complex {
    float real;
    float imag;
};

class AdjointKernel {
 public:
    __aicore__ inline void Init(GM_ADDR shared, GM_ADDR costate, GM_ADDR instructions, GM_ADDR data, GM_ADDR offsets,
                                GM_ADDR steps, GM_ADDR derivatives, GM_ADDR targets, GM_ADDR partials, uint64_t plane,
                                uint64_t external_mask, uint32_t size, uint32_t run, uint32_t step_count,
                                uint32_t output_size) {
        shared_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(shared));
        costate_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(costate));
        partials_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partials));
        instructions_ = reinterpret_cast<__gm__ Instruction*>(instructions);
        offsets_ = reinterpret_cast<__gm__ uint64_t*>(offsets);
        steps_ = reinterpret_cast<__gm__ AdjointStep*>(steps);
        derivatives_ = reinterpret_cast<__gm__ AdjointDerivative*>(derivatives);
        targets_ = reinterpret_cast<__gm__ GradientTarget*>(targets);
        plane_ = plane;
        external_mask_ = external_mask;
        size_ = size;
        run_ = run;
        count_ = step_count;
        output_size_ = output_size;
        // Two live complex tiles and ONE reusable derivative tile. No GM
        // derivative state and no scratch allocation dependent on parameters.
        pipe_.InitBuffer(states_buf_, 6 * Capacity * sizeof(float));
        pipe_.InitBuffer(reduce_buf_, 3 * Capacity * sizeof(float));
        pipe_.InitBuffer(partial_buf_, kGradientPartialStride * sizeof(float));
        executor_.Init(pipe_, data, size);
    }

    __aicore__ inline void Run(uint64_t tiles, bool compute_overlap) {
        auto shared = states_buf_.Get<float>();
        auto costate = shared[2 * Capacity];
        auto derivative_state = shared[4 * Capacity];
        for (uint64_t tile = GetBlockIdx(); tile < tiles; tile += GetBlockNum()) {
            const auto base = device::Deposit(tile, external_mask_);
            for (uint32_t offset = 0; offset < size_; offset += run_) {
                const auto global = base | offsets_[offset / run_];
                DataCopy(shared[offset], shared_[global], run_);
                DataCopy(shared[Capacity + offset], shared_[plane_ + global], run_);
                DataCopy(costate[offset], costate_[global], run_);
                DataCopy(costate[Capacity + offset], costate_[plane_ + global], run_);
            }
            SetFlag<HardEvent::MTE2_V>(EVENT_ID2);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID2);
            if (compute_overlap) {
                AddPartial(0, Dot(shared, costate));
            }
            for (uint32_t index = 0; index < count_; ++index) {
                const auto& step = steps_[index];
                Evolve(step, base, shared);
                for (uint32_t d = 0; d < step.derivative_count; ++d) {
                    const auto& derivative = derivatives_[step.derivative_begin + d];
                    Complex intrinsic{0.0F, 0.0F};
                    for (uint32_t i = 0; i < derivative.instruction_count; ++i) {
                        const auto& op = instructions_[derivative.instruction_begin + i];
                        if (!device::Matches(op, base)) {
                            continue;  // Inactive controls/parity contribute ZERO.
                        }
                        Adds(derivative_state, costate, 0.0F, size_);
                        Adds(derivative_state[Capacity], costate[Capacity], 0.0F, size_);
                        PipeBarrier<PIPE_V>();
                        executor_.Apply(op, derivative_state);
                        const auto part = Dot(shared, derivative_state);
                        intrinsic.real += part.real;
                        intrinsic.imag += part.imag;
                    }
                    for (uint32_t t = 0; t < derivative.target_count; ++t) {
                        const auto& target = targets_[derivative.target_begin + t];
                        const float real = target.real, imag = target.imag;
                        AddPartial(target.output_index, {intrinsic.real * real - intrinsic.imag * imag,
                                                         intrinsic.real * imag + intrinsic.imag * real});
                    }
                }
                Evolve(step, base, costate);
            }
            SetFlag<HardEvent::V_MTE3>(EVENT_ID2);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
            for (uint32_t offset = 0; offset < size_; offset += run_) {
                const auto global = base | offsets_[offset / run_];
                DataCopy(shared_[global], shared[offset], run_);
                DataCopy(shared_[plane_ + global], shared[Capacity + offset], run_);
                DataCopy(costate_[global], costate[offset], run_);
                DataCopy(costate_[plane_ + global], costate[Capacity + offset], run_);
            }
            SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID2);
            WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID2);
        }
    }

 private:
    __aicore__ inline void Evolve(const __gm__ AdjointStep& step, uint64_t base, LocalTensor<float> state) {
        for (uint32_t i = 0; i < step.evolution_count; ++i) {
            const auto& op = instructions_[step.evolution_begin + i];
            if (device::Matches(op, base)) {
                executor_.Apply(op, state);
            }
        }
    }

    __aicore__ inline float SumEight(LocalTensor<float> values) {
        const float a = values.GetValue(0) + values.GetValue(1);
        const float b = values.GetValue(2) + values.GetValue(3);
        const float c = values.GetValue(4) + values.GetValue(5);
        const float d = values.GetValue(6) + values.GetValue(7);
        return (a + b) + (c + d);
    }

    __aicore__ inline Complex Dot(LocalTensor<float> bra, LocalTensor<float> ket) {
        auto real = reduce_buf_.Get<float>();
        auto imag = real[Capacity];
        auto work = real[2 * Capacity];
        Mul(real, bra, ket, size_);
        Mul(work, bra[Capacity], ket[Capacity], size_);
        PipeBarrier<PIPE_V>();
        Add(real, real, work, size_);
        PipeBarrier<PIPE_V>();
        Mul(imag, bra, ket[Capacity], size_);
        Mul(work, bra[Capacity], ket, size_);
        PipeBarrier<PIPE_V>();
        Sub(imag, imag, work, size_);
        PipeBarrier<PIPE_V>();
        // Fixed balanced tree, independent of scheduling or atomic ordering.
        // The final eight lanes use a balanced FP32 scalar tree as well.
        for (uint32_t half = size_ / 2; half >= 8; half /= 2) {
            Add(real, real, real[half], half);
            Add(imag, imag, imag[half], half);
            PipeBarrier<PIPE_V>();
        }
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        const Complex result{SumEight(real), SumEight(imag)};
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        return result;
    }

    __aicore__ inline void AddPartial(uint32_t output, Complex value) {
        const auto offset = (static_cast<uint64_t>(GetBlockIdx()) * output_size_ + output) * kGradientPartialStride;
        auto slot = partial_buf_.Get<float>();
        DataCopy(slot, partials_[offset], kGradientPartialStride);
        SetFlag<HardEvent::MTE2_S>(EVENT_ID1);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID1);
        // Compensate the sum across state tiles and repeated uses of a shared
        // parameter. A balanced tile reduction alone does not prevent loss
        // of small contributions during a large-state/deep-circuit sweep.
        const float contributions[] = {value.real, value.imag};
        for (uint32_t component = 0; component < 2; ++component) {
            const float sum = slot.GetValue(component);
            const float adjusted = contributions[component] - slot.GetValue(component + 2);
            const float next = sum + adjusted;
            slot.SetValue(component + 2, (next - sum) - adjusted);
            slot.SetValue(component, next);
        }
        SetFlag<HardEvent::S_MTE3>(EVENT_ID1);
        WaitFlag<HardEvent::S_MTE3>(EVENT_ID1);
        DataCopy(partials_[offset], slot, kGradientPartialStride);
        // No other block touches this slot. Drain before reading or reusing it.
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
    }

    TPipe pipe_;
    TBuf<TPosition::VECCALC> states_buf_, reduce_buf_, partial_buf_;
    device::TileExecutor<Capacity> executor_;
    GlobalTensor<float> shared_, costate_, partials_;
    __gm__ Instruction* instructions_;
    __gm__ uint64_t* offsets_;
    __gm__ AdjointStep* steps_;
    __gm__ AdjointDerivative* derivatives_;
    __gm__ GradientTarget* targets_;
    uint64_t plane_, external_mask_;
    uint32_t size_, run_, count_, output_size_;
};
}  // namespace

extern "C" __global__ __aicore__ void mq_ascend_adjoint(GM_ADDR shared, GM_ADDR costate, GM_ADDR instructions,
                                                        GM_ADDR data, GM_ADDR offsets, GM_ADDR steps,
                                                        GM_ADDR derivatives, GM_ADDR targets, GM_ADDR partials,
                                                        uint64_t plane, uint64_t external_mask, uint64_t tiles,
                                                        uint32_t size, uint32_t run, uint32_t step_count,
                                                        uint32_t output_size, uint32_t compute_overlap) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    AdjointKernel kernel;
    kernel.Init(shared, costate, instructions, data, offsets, steps, derivatives, targets, partials, plane,
                external_mask, size, run, step_count, output_size);
    kernel.Run(tiles, compute_overlap != 0);
}

namespace mindquantum::sim::ascend {
aclError LaunchAdjointTile(uint32_t blocks, aclrtStream stream, void* shared_state, void* costate, void* instructions,
                           void* data, void* offsets, void* steps, void* derivatives, void* targets, void* partials,
                           uint64_t plane, uint64_t external_mask, uint64_t tiles, uint32_t size, uint32_t run,
                           uint32_t step_count, uint32_t output_size, uint32_t compute_overlap) {
    mq_ascend_adjoint<<<blocks, nullptr, stream>>>(
        static_cast<uint8_t*>(shared_state), static_cast<uint8_t*>(costate), static_cast<uint8_t*>(instructions),
        static_cast<uint8_t*>(data), static_cast<uint8_t*>(offsets), static_cast<uint8_t*>(steps),
        static_cast<uint8_t*>(derivatives), static_cast<uint8_t*>(targets), static_cast<uint8_t*>(partials), plane,
        external_mask, tiles, size, run, step_count, output_size, compute_overlap);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
}  // namespace mindquantum::sim::ascend
