#include <acl/acl.h>

#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "simulator/vector/ascend/device_program.h"
#include "simulator/vector/ascend/kernel_launch.h"

using namespace AscendC;                   // NOLINT
using namespace mindquantum::sim::ascend;  // NOLINT

namespace {
using Matrix = MatmulType<TPosition::GM, CubeFormat::ND, float>;

__aicore__ uint64_t Deposit(uint64_t value, uint64_t mask) {
    uint64_t result = 0;
    while (mask) {
        const auto bit = mask & (~mask + 1);
        if (value & 1) {
            result |= bit;
        }
        value >>= 1;
        mask ^= bit;
    }
    return result;
}

template <HardEvent event>
__aicore__ inline void Sync() {
    SetFlag<event>(EVENT_ID0);
    WaitFlag<event>(EVENT_ID0);
}

struct Complex {
    float real;
    float imag;
};

class DenseAdjointKernel {
 public:
    __aicore__ inline void Init(TPipe& pipe, GM_ADDR shared, GM_ADDR costate, GM_ADDR matrix, GM_ADDR derivatives,
                                GM_ADDR outputs, GM_ADDR offsets, GM_ADDR indices, GM_ADDR inverse, GM_ADDR workspace,
                                GM_ADDR partials, DensePacket packet, uint32_t rows, uint32_t output_size) {
        packet_ = packet;
        rows_ = rows;
        columns_ = 2 * packet.size / rows;
        output_size_ = output_size;
        shared_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(shared));
        costate_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(costate));
        matrix_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(matrix));
        derivatives_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(derivatives));
        partials_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partials));
        outputs_ = reinterpret_cast<__gm__ uint32_t*>(outputs);
        offsets_ = reinterpret_cast<__gm__ uint64_t*>(offsets);
        const uint32_t batch = 2 * packet.size * kDenseBatchPackets;
        auto* worker = reinterpret_cast<__gm__ float*>(workspace) + GetBlockIdx() * 5 * batch;
        batch_input_.SetGlobalBuffer(worker, 2 * batch);
        batch_output_.SetGlobalBuffer(worker + 2 * batch, 2 * batch);
        batch_derivative_.SetGlobalBuffer(worker + 4 * batch, batch);
        pipe.InitBuffer(physical_buf_, 2 * packet.size * sizeof(float));
        pipe.InitBuffer(input_buf_, 2 * packet.size * sizeof(float));
        pipe.InitBuffer(output_buf_, 2 * packet.size * sizeof(float));
        pipe.InitBuffer(index_buf_, 2 * packet.size * sizeof(uint32_t));
        pipe.InitBuffer(reduce_buf_, 3 * packet.size * sizeof(float));
        pipe.InitBuffer(scalar_buf_, 8 * sizeof(float));
        pipe.InitBuffer(partial_buf_, kGradientPartialStride * sizeof(float));
        GlobalTensor<uint32_t> forward, backward;
        forward.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(indices));
        backward.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(inverse));
        DataCopy(index_buf_.Get<uint32_t>(), forward, packet.size);
        DataCopy(index_buf_.Get<uint32_t>()[packet.size], backward, packet.size);
        Sync<HardEvent::MTE2_V>();
    }

    __aicore__ inline void Run(Matmul<Matrix, Matrix, Matrix>& mm, uint32_t derivative_count, bool overlap) {
        auto input = input_buf_.Get<float>();
        auto output = output_buf_.Get<float>();
        const auto size = packet_.size;
        const auto tile_count = packet_.plane / size;
        const auto step = GetBlockNum() * GetTaskRation() * kDenseBatchPackets;
        const DataCopyParams pack{static_cast<uint16_t>(rows_), static_cast<uint16_t>(columns_ / 8), 0,
                                  static_cast<uint16_t>((2 * kDenseBatchPackets - 1) * columns_ / 8)};
        for (uint64_t first = GetBlockIdx() * kDenseBatchPackets; first < tile_count; first += step) {
            const uint32_t count = tile_count - first < kDenseBatchPackets ? tile_count - first : kDenseBatchPackets;
            for (uint32_t i = 0; i < count; ++i) {
                const auto base = Deposit(first + i, packet_.external_mask);
                Load(costate_, input, base);
                DataCopy(batch_input_[i * columns_], input, pack);
                PipeBarrier<PIPE_ALL>();
                Load(shared_, output, base);
                if (overlap) {
                    AddPartial(0, Dot(output, input));
                }
                Sync<HardEvent::V_MTE3>();
                DataCopy(batch_input_[(count + i) * columns_], output, pack);
                PipeBarrier<PIPE_ALL>();
            }
            // One multiplication reconstructs both states. Retain only this
            // bounded batch of psi_before and the original lambda_after.
            Multiply(mm, matrix_, batch_output_, 2 * count);
            for (uint32_t i = 0; i < count; ++i) {
                const auto base = Deposit(first + i, packet_.external_mask);
                DataCopy(output, batch_output_[i * 2 * size], 2 * size);
                Sync<HardEvent::MTE2_V>();
                Store(costate_, output, base);
                DataCopy(output, batch_output_[(count + i) * 2 * size], 2 * size);
                Sync<HardEvent::MTE2_V>();
                Store(shared_, output, base);
            }
            for (uint32_t d = 0; d < derivative_count; ++d) {
                Multiply(mm, derivatives_[d * rows_ * rows_], batch_derivative_, count);
                for (uint32_t i = 0; i < count; ++i) {
                    DataCopy(input, batch_output_[(count + i) * 2 * size], 2 * size);
                    DataCopy(output, batch_derivative_[i * 2 * size], 2 * size);
                    Sync<HardEvent::MTE2_V>();
                    AddPartial(outputs_[d], Dot(input, output));
                    PipeBarrier<PIPE_ALL>();
                }
            }
        }
    }

 private:
    __aicore__ inline void Multiply(Matmul<Matrix, Matrix, Matrix>& mm, GlobalTensor<float> matrix,
                                    GlobalTensor<float> output, uint32_t packets) {
        mm.SetHF32(false);
        mm.SetTail(rows_, packets * columns_, rows_);
        mm.SetTensorA(matrix);
        mm.SetTensorB(batch_input_);
        mm.IterateAll<false>(output, 0, true, true);
        mm.WaitIterateAll();
        mm.End();
    }

    __aicore__ inline void Load(GlobalTensor<float> state, LocalTensor<float> packed, uint64_t base) {
        auto physical = physical_buf_.Get<float>();
        const auto size = packet_.size;
        for (uint32_t offset = 0; offset < size; offset += packet_.run) {
            const auto global = base | offsets_[offset / packet_.run];
            DataCopy(physical[offset], state[global], packet_.run);
            DataCopy(physical[size + offset], state[packet_.plane + global], packet_.run);
        }
        Sync<HardEvent::MTE2_V>();
        Gather(packed, physical, index_buf_.Get<uint32_t>(), 0, size);
        Gather(packed[size], physical[size], index_buf_.Get<uint32_t>(), 0, size);
        Sync<HardEvent::V_MTE3>();
    }

    __aicore__ inline void Store(GlobalTensor<float> state, LocalTensor<float> packed, uint64_t base) {
        auto physical = physical_buf_.Get<float>();
        const auto size = packet_.size;
        auto inverse = index_buf_.Get<uint32_t>()[size];
        Gather(physical, packed, inverse, 0, size);
        Gather(physical[size], packed[size], inverse, 0, size);
        Sync<HardEvent::V_MTE3>();
        for (uint32_t offset = 0; offset < size; offset += packet_.run) {
            const auto global = base | offsets_[offset / packet_.run];
            DataCopy(state[global], physical[offset], packet_.run);
            DataCopy(state[packet_.plane + global], physical[size + offset], packet_.run);
        }
        PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline float Sum(LocalTensor<float> values) {
        auto scalar = scalar_buf_.Get<float>();
        Sync<HardEvent::S_V>();
        ReduceSum(scalar, values, reduce_buf_.Get<float>()[2 * packet_.size], packet_.size);
        Sync<HardEvent::V_S>();
        return scalar.GetValue(0);
    }

    __aicore__ inline Complex Dot(LocalTensor<float> bra, LocalTensor<float> ket) {
        const auto size = packet_.size;
        auto real = reduce_buf_.Get<float>();
        auto imag = real[size];
        auto work = real[2 * size];
        Mul(real, bra, ket, size);
        Mul(work, bra[size], ket[size], size);
        PipeBarrier<PIPE_V>();
        Add(real, real, work, size);
        PipeBarrier<PIPE_V>();
        Mul(imag, bra, ket[size], size);
        Mul(work, bra[size], ket, size);
        PipeBarrier<PIPE_V>();
        Sub(imag, imag, work, size);
        PipeBarrier<PIPE_V>();
        const auto r = Sum(real);
        const auto i = Sum(imag);
        Sync<HardEvent::S_V>();
        return {r, i};
    }

    __aicore__ inline void AddPartial(uint32_t output, Complex value) {
        const auto offset = (static_cast<uint64_t>(GetBlockIdx()) * output_size_ + output) * kGradientPartialStride;
        auto slot = partial_buf_.Get<float>();
        DataCopy(slot, partials_[offset], kGradientPartialStride);
        Sync<HardEvent::MTE2_S>();
        const float contributions[] = {value.real, value.imag};
        for (uint32_t component = 0; component < 2; ++component) {
            const float sum = slot.GetValue(component);
            const float adjusted = contributions[component] - slot.GetValue(component + 2);
            const float next = sum + adjusted;
            slot.SetValue(component + 2, (next - sum) - adjusted);
            slot.SetValue(component, next);
        }
        Sync<HardEvent::S_MTE3>();
        DataCopy(partials_[offset], slot, kGradientPartialStride);
        Sync<HardEvent::MTE3_MTE2>();
    }

    TBuf<TPosition::VECCALC> physical_buf_, input_buf_, output_buf_, index_buf_, reduce_buf_, scalar_buf_, partial_buf_;
    GlobalTensor<float> shared_, costate_, matrix_, derivatives_, partials_;
    GlobalTensor<float> batch_input_, batch_output_, batch_derivative_;
    __gm__ uint32_t* outputs_;
    __gm__ uint64_t* offsets_;
    DensePacket packet_;
    uint32_t rows_, columns_, output_size_;
};
}  // namespace

extern "C" __global__ __aicore__ void mq_ascend_dense(GM_ADDR state, GM_ADDR matrix, GM_ADDR offsets, GM_ADDR indices,
                                                      GM_ADDR config, __kfc_workspace__ GM_ADDR workspace,
                                                      DensePacket packet) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    TCubeTiling tiling;
    auto* words = reinterpret_cast<uint32_t*>(&tiling);
    const auto* source = reinterpret_cast<__gm__ uint32_t*>(config);
    for (uint32_t i = 0; i < sizeof(tiling) / sizeof(uint32_t); ++i) {
        words[i] = source[i];
    }
    TPipe pipe;
    Matmul<Matrix, Matrix, Matrix> mm;
    // The workspace-qualified entry initializes CANN's mixed-core protocol.
    // Its body receives the user slice; registration needs the system slice.
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    if ASCEND_IS_AIV {
        TBuf<TPosition::VECCALC> state_buf, input_buf, output_buf, index_buf;
        pipe.InitBuffer(state_buf, 2 * packet.size * sizeof(float));
        pipe.InitBuffer(input_buf, 2 * packet.size * sizeof(float));
        pipe.InitBuffer(output_buf, 2 * packet.size * sizeof(float));
        pipe.InitBuffer(index_buf, packet.size * sizeof(uint32_t));
        auto physical = state_buf.Get<float>();
        auto input = input_buf.Get<float>();
        auto output = output_buf.Get<float>();
        auto routing = index_buf.Get<uint32_t>();
        GlobalTensor<float> amplitudes, coefficients;
        GlobalTensor<float> batch_input[kDensePipelineSlots], batch_output[kDensePipelineSlots];
        GlobalTensor<uint32_t> index_source;
        amplitudes.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(state));
        coefficients.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(matrix));
        index_source.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(indices));
        const auto* segments = reinterpret_cast<__gm__ uint64_t*>(offsets);
        const uint32_t rows = tiling.M;
        const uint32_t columns = 2 * packet.size / rows;
        const uint32_t batch_elements = 2 * packet.size * kDenseBatchPackets;
        auto* worker_workspace = reinterpret_cast<__gm__ float*>(workspace)
                                 + GetBlockIdx() * 2 * kDensePipelineSlots * batch_elements;
        for (uint32_t slot = 0; slot < kDensePipelineSlots; ++slot) {
            batch_input[slot].SetGlobalBuffer(worker_workspace + 2 * slot * batch_elements, batch_elements);
            batch_output[slot].SetGlobalBuffer(worker_workspace + (2 * slot + 1) * batch_elements, batch_elements);
        }
        const DataCopyParams pack{static_cast<uint16_t>(rows), static_cast<uint16_t>(columns / 8), 0,
                                  static_cast<uint16_t>((kDenseBatchPackets - 1) * columns / 8)};
        DataCopy(routing, index_source, packet.size);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        // AIV indices are flattened, while GetBlockNum counts Cube cores.
        const auto step = GetBlockNum() * GetTaskRation() * kDenseBatchPackets;
        const uint64_t tile_count = packet.plane / packet.size;
        const uint64_t start = GetBlockIdx() * kDenseBatchPackets;
        uint32_t slot = 0;
        for (uint64_t first = start; start < tile_count && first < tile_count + step; first += step, slot ^= 1) {
            const bool active = first < tile_count;
            const uint32_t count
                = active ? (tile_count - first < kDenseBatchPackets ? tile_count - first : kDenseBatchPackets) : 0;
            if (active) {
                // Load this batch while the previous Cube operation is active.
                for (uint32_t i = 0; i < count; ++i) {
                    const auto base = Deposit(first + i, packet.external_mask);
                    for (uint32_t offset = 0; offset < packet.size; offset += packet.run) {
                        const auto global = base | segments[offset / packet.run];
                        DataCopy(physical[offset], amplitudes[global], packet.run);
                        DataCopy(physical[packet.size + offset], amplitudes[packet.plane + global], packet.run);
                    }
                    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    Gather(input, physical, routing, 0, packet.size);
                    Gather(input[packet.size], physical[packet.size], routing, 0, packet.size);
                    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                    DataCopy(batch_input[slot][i * columns], input, pack);
                    PipeBarrier<PIPE_ALL>();
                }
            }
            if (first != start) {
                mm.WaitIterateAll();
                mm.End();
            }
            if (active) {
                mm.SetHF32(false);
                mm.SetTail(rows, count * columns, rows);
                mm.SetTensorA(coefficients);
                mm.SetTensorB(batch_input[slot]);
                // Sequential output is required by asynchronous completion.
                mm.IterateAll<false>(batch_output[slot], 0, true, true);
            }
            if (first != start) {
                const auto previous = first - step;
                const uint32_t previous_count = tile_count - previous < kDenseBatchPackets ? tile_count - previous
                                                                                           : kDenseBatchPackets;
                // Write the previous batch while this Cube operation is active.
                // One inactive terminal iteration drains the last output.
                for (uint32_t i = 0; i < previous_count; ++i) {
                    const auto base = Deposit(previous + i, packet.external_mask);
                    DataCopy(output, batch_output[slot ^ 1][i * 2 * packet.size], 2 * packet.size);
                    SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
                    WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
                    for (uint32_t offset = 0; offset < packet.size; offset += packet.run) {
                        const auto global = base | segments[offset / packet.run];
                        DataCopy(amplitudes[global], output[offset], packet.run);
                        DataCopy(amplitudes[packet.plane + global], output[packet.size + offset], packet.run);
                    }
                    PipeBarrier<PIPE_ALL>();
                }
            }
        }
    }
}

extern "C" __global__ __aicore__ void mq_ascend_dense_adjoint(GM_ADDR shared, GM_ADDR costate, GM_ADDR matrix,
                                                              GM_ADDR derivatives, GM_ADDR outputs, GM_ADDR offsets,
                                                              GM_ADDR indices, GM_ADDR inverse, GM_ADDR config,
                                                              __kfc_workspace__ GM_ADDR workspace, GM_ADDR partials,
                                                              DensePacket packet, uint32_t derivative_count,
                                                              uint32_t output_size, uint32_t compute_overlap) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    TCubeTiling tiling;
    auto* words = reinterpret_cast<uint32_t*>(&tiling);
    const auto* source = reinterpret_cast<__gm__ uint32_t*>(config);
    for (uint32_t i = 0; i < sizeof(tiling) / sizeof(uint32_t); ++i) {
        words[i] = source[i];
    }
    TPipe pipe;
    Matmul<Matrix, Matrix, Matrix> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    if ASCEND_IS_AIV {
        DenseAdjointKernel kernel;
        kernel.Init(pipe, shared, costate, matrix, derivatives, outputs, offsets, indices, inverse, workspace, partials,
                    packet, tiling.M, output_size);
        kernel.Run(mm, derivative_count, compute_overlap != 0);
    }
}

namespace mindquantum::sim::ascend {
aclError LaunchDense(uint32_t blocks, aclrtStream stream, void* state, void* matrix, void* offsets, void* indices,
                     void* tiling, void* workspace, DensePacket packet) {
    mq_ascend_dense<<<blocks, nullptr, stream>>>(
        static_cast<uint8_t*>(state), static_cast<uint8_t*>(matrix), static_cast<uint8_t*>(offsets),
        static_cast<uint8_t*>(indices), static_cast<uint8_t*>(tiling), static_cast<uint8_t*>(workspace), packet);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

aclError LaunchDenseAdjoint(uint32_t blocks, aclrtStream stream, void* shared_state, void* costate, void* matrix,
                            void* derivatives, void* outputs, void* offsets, void* indices, void* inverse_indices,
                            void* tiling, void* workspace, void* partials, DensePacket packet,
                            uint32_t derivative_count, uint32_t output_size, uint32_t compute_overlap) {
    mq_ascend_dense_adjoint<<<blocks, nullptr, stream>>>(
        static_cast<uint8_t*>(shared_state), static_cast<uint8_t*>(costate), static_cast<uint8_t*>(matrix),
        static_cast<uint8_t*>(derivatives), static_cast<uint8_t*>(outputs), static_cast<uint8_t*>(offsets),
        static_cast<uint8_t*>(indices), static_cast<uint8_t*>(inverse_indices), static_cast<uint8_t*>(tiling),
        static_cast<uint8_t*>(workspace), static_cast<uint8_t*>(partials), packet, derivative_count, output_size,
        compute_overlap);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
}  // namespace mindquantum::sim::ascend
